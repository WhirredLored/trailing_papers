# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key. Both are safe in the browser: the anon key is bound by
# Row Level Security, which is the security boundary (Architecture Law 1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. BYPASSES RLS. Server-only — never prefix with NEXT_PUBLIC_, never
# import lib/supabase-server.ts from client code (Architecture Law 9).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe (C14) ────────────────────────────────────────────────────────────
# Publishable key is browser-safe; the secret key and webhook signing secret are not.
# Webhooks are verified against the RAW request body (Architecture Law 9).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (C09/C10) ─────────────────────────────────────────────────────────
# Transactional provider used for issued documents and share links.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# ─── App ─────────────────────────────────────────────────────────────────────
# Absolute origin used to build client-facing share links (Architecture Law 7).
NEXT_PUBLIC_APP_URL=http://localhost:3000
